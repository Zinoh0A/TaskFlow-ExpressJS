<%- include('./partials/header') %>

<div class="container">
  <h2><i class="fas fa-plus-circle"></i> Create New Task</h2>
  
  <form action="/todos" method="POST" class="todo-form">
    <div class="form-group">
      <label for="title"><i class="fas fa-heading"></i> Task Title</label>
      <input type="text" id="title" name="title" placeholder="What do you need to do?" required autofocus>
    </div>
    
    <div class="form-group">
      <label for="description"><i class="fas fa-align-left"></i> Task Details</label>
      <textarea id="description" name="description" rows="3" placeholder="Add any additional details here..."></textarea>
    </div>
    
    <button type="submit" class="btn">
      <i class="fas fa-plus"></i> Add Task
    </button>
  </form>
  
  <div class="navigation">
    <a href="/todos" class="btn">
      <i class="fas fa-tasks"></i> View All Tasks
    </a>
  </div>
</div>

<%- include('./partials/footer') %>