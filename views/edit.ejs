<%- include('./partials/header') %>

<div class="container">
  <h2>Edit Task</h2>
  
  <form action="/todos/<%= todo._id %>?_method=PATCH" method="POST" class="todo-form">
    <div class="form-group">
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" value="<%= todo.title %>" required>
    </div>
    
    <div class="form-group">
      <label for="description">Description:</label>
      <textarea id="description" name="description" rows="3"><%= todo.description %></textarea>
    </div>
    
    <div class="form-actions">
      <button type="submit" class="btn">Update Task</button>
      <a href="/todos" class="btn" style="background-color: #6b7280;">Cancel</a>
    </div>
  </form>
</div>

<%- include('./partials/footer') %>